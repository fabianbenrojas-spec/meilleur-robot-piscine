# Marché déployé. be-fr | be-nl | fr-fr
MARKET=be-fr

# Le site n'est indexable qu'à true. Laisser à false jusqu'à ce que la première
# vague soit en ligne et relue.
SITE_LAUNCHED=false

# Le tracking ID Amazon n'est PAS ici : ce n'est pas un secret (il est visible
# dans chaque URL sortante), et une variable oubliée sur un nouveau projet
# Vercel produirait des liens sans attribution. Il vit dans
# config/markets/<marketId>.ts, versionné et relu en PR.
